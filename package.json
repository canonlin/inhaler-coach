{
  "name": "inhaler-coach-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite",
    "build": "tsc --noEmit && node scripts/copy-ort.mjs && vite build",
    "postinstall": "node scripts/copy-ort.mjs",
    "preview": "vite preview",
    "preflight": "node scripts/demo-preflight.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node --experimental-test-coverage --test",
    "test:e2e": "bunx playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "typecheck": "tsc --noEmit",
    "check:all": "bun run typecheck && bun run test",
    "prepush": "bun run check:all",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test:api": "node --test test/api-integration.test.js",
    "test:db": "node scripts/test.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "render:outcomes": "node scripts/render-outcomes.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "onnxruntime-web": "^1.27.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/youtube": "^0.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
